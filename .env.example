# Copie para .env e ajuste. Em produção o Railway injeta estas variáveis.
SECRET_KEY=troque-por-uma-chave-secreta-forte
DEBUG=false
# DATABASE_URL é injetada automaticamente pela referência ao serviço MySQL:
# DATABASE_URL=mysql://user:senha@host:3306/railway

# Importa a planilha-base (919 processos) no boot — idempotente
IMPORT_PLANILHA=true
# Seed antigo de testes (119 processos do SQLite) — desativado
SEED_DATA=false

# Integração ControlJus (JusControl)
CONTROLJUS_EMAIL=seu-email@example.com
CONTROLJUS_PASSWORD=sua-senha
CONTROLJUS_CONTRATO_ID=197379

# Análise por IA (Claude API)
ANTHROPIC_API_KEY=
IA_MODELO=claude-opus-4-8
